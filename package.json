{
  "name": "arbmusic",
  "version": "1.2.1",
  "description": "ArbMusic — музыкальный плеер (Android APK, веб для iPhone, Windows EXE)",
  "main": "electron/main.js",
  "scripts": {
    "electron": "electron .",
    "build:win": "electron-builder --win nsis",
    "cap:sync": "cap sync android"
  },
  "author": "arbuzikyt99",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/device": "^8.0.3",
    "electron-updater": "^6.8.11"
  },
  "build": {
    "appId": "com.arbuzik.arbmusic",
    "productName": "ArbMusic",
    "directories": {
      "output": "dist-win"
    },
    "files": [
      "www/**/*",
      "electron/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ArbMusic-Setup.exe",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "installerLanguages": [
        "ru-RU",
        "en-US"
      ],
      "uninstallDisplayName": "ArbMusic"
    },
    "publish": {
      "provider": "github",
      "owner": "arbuzikyt99",
      "repo": "ArbMusicPlayer"
    }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
